{
  "title": "folder",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "javaType": "com.sos.joc.model.tree.Tree",
  "type": "object",
  "properties": {
    "path": {
      "$ref": "../common/path-schema.json"
    },
    "name": {
      "type": "string"
    },
    "deleted": {
      "type": "boolean"
    },
    "permitted": {
      "type": "boolean",
      "default": true
    },
    "repoControlled": {
      "description": "only for top level folder in the reponse",
      "type": "boolean"
    },
    "lockedBy": {
      "type": "string"
    },
    "lockedSince": {
	  "$ref": "../common/timestamp-schema.json"
	},
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
	"folders": {
      "type": "array",
      "items": {
        "$ref": "tree-schema.json"
      }
    }
  },
  "required": [
    "path",
    "name"
  ]

}
