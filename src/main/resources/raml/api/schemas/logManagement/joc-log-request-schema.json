{
	"title": "controller log filter",
	"$schema": "http://json-schema.org/draft-04/schema#",
	"javaType": "com.sos.joc.model.log.JOCLogRequest",
	"type": "object",
	"extends" : {
        "$ref": "log-request-schema.json"
    },
    "required": [
	    "serviceId",
        "dateFrom"
	],
	"properties": {
		"serviceId": {
            "type": "string",
            "javaType": "com.sos.joc.model.log.JOCServiceId",
            "enum": [
                "JOC",
                "CLUSTER",
                "HISTORY",
                "DAILYPLAN",
                "CLEANUP",
                "MONITOR",
                "LOGNOTIFICATION",
                "REPORTS",
                "AUTHENTICATION",
                "AUDIT"   
            ]
        }
	},
    "additionalProperties": false
}
