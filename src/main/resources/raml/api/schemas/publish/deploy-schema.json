{
  "title": "deploy",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "javaType": "com.sos.joc.model.publish.DeployFilter",
  "type": "object",
  "anyOf": [
    {
      "required": ["controllerIds","store"]
    }, {
      "required": ["controllerIds","delete"]
    }
  ],
  "properties": {
    "controllerIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common/controllerIdRequired-schema.json"
      }
    },
    "store": {
      "$ref": "deployablesValidFilter-schema.json"
    },
    "delete": {
      "$ref": "deployDelete-schema.json"
    },
    "addOrdersDateFrom": {
      "$ref": "../common/string255-schema.json"
    },
    "transactionId": {
      "$ref": "../common/string100-schema.json"
    },
    "includeLate": {
      "type": "boolean",
      "default": false
    },
    "auditLog": {
      "$ref": "../audit/auditParams-schema.json"
    }
  }
}